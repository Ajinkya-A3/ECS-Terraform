region      = "ap-south-1"
project     = "voice-agent"
environment = "dev"

resilience_image = "at1asflame/ecs-test:service"
mock_image       = "at1asflame/ecs-test:mock"

resilience_port        = 8000
resilience_health_path = "/health"
mock_port              = 9000
mock_health_path       = "/health"

cpu_architecture  = "X86_64"
enable_blue_green = false
bake_time_minutes = 5

# Mock env (from your compose file)
mock_env = {
  MOCK_FAIL_RATE = "0.20"
  MOCK_SIGMA     = "0.6"
}

# Service env (PIPELINE_BACKEND and PIPELINE_URL are added in ecs.tf)
resilience_env = {
  REQUEST_TIMEOUT_S = "3"
  RETRY_ATTEMPTS    = "3"
  RETRY_INITIAL_S   = "0.2"
  RETRY_MAX_S       = "2.0"

  BREAKER_FAIL_MAX = "5"
  BREAKER_RESET_S  = "15"

  DLQ_PATH = "/data/dlq.db"
}